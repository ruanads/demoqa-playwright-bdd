{
  "name": "desafio-qa-automation",
  "version": "1.0.0",
  "description": "Desafio QA Automation (DemoQA) com Playwright + TypeScript + BDD",
  "scripts": {
    "test": "bddgen && playwright test --project=api --project=ui",
    "bddgen": "bddgen",
    "test:api": "bddgen && playwright test --project=api",
    "test:ui": "bddgen && playwright test --project=ui",
    "test:headed": "bddgen && playwright test --project=ui --headed",
    "typecheck": "tsc",
    "report": "playwright show-report relatorios/playwright",
    "lint": "eslint .",
    "test:bugs": "bddgen && playwright test --project=bugs",
    "report:cucumber": "node -e \"require('child_process').exec((process.platform==='win32'?'start \\\"\\\" ':process.platform==='darwin'?'open ':'xdg-open ')+'relatorios/cucumber/index.html')\""
  },
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-plugin-playwright": "^2.12.1",
    "playwright-bdd": "^9.2.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=22"
  }
}
