{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@api/*": ["./src/api/*"],
      "@config/*": ["./src/config/*"],
      "@data/*": ["./src/data/*"],
      "@fixtures": ["./src/fixtures/index.ts"],
      "@paginas/*": ["./src/paginas/*"]
    }
  },
  "include": ["src/**/*.ts", "testes/**/*.ts", "playwright.config.ts"]
}
